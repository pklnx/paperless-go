{
  // vite.config.ts, build/ and scripts/ run in Node: Node's types, and only there
  // (the UI's code in src/ is checked without them, as the browser has no
  // Node APIs).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    // vite.config.ts imports build/stripRemoteFonts.ts with its extension (Vite's native config loader asks for it).
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "build", "scripts"]
}
