{
  "name": "paperless-go-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build && node -e \"require('fs').writeFileSync('../internal/web/ui/dist/.keep', '')\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "dependencies": {
    "@carbon/icons-react": "11.91.0",
    "@carbon/react": "1.119.0",
    "@carbon/styles": "1.118.0",
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0",
    "@pklnx/design-system": "https://github.com/pklnx/design-system/releases/download/v0.2.0/pklnx-design-system-0.2.0.tgz",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
