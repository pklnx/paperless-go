# Copy to .env and fill in. Never commit .env.

# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me

# Required. Encrypts the two-factor (TOTP) secrets and keys the recovery
# codes. Generate it once with `./pgo keygen` and paste the line it prints
# here. Keep it with your backups: with another key nobody with two-factor
# login can log in (reset them with `./pgo user reset-2fa NAME`).
PAPERLESS_GO_SECRET_KEY=

# Admins always log in with a password and a TOTP code. true requires it
# for every user; set it on a server that is reachable from the internet
# (docs/guide/internet.md).
#PAPERLESS_GO_REQUIRE_2FA=false

# Passkeys (Face ID, Touch ID, Windows Hello, security keys) need the
# address you open in the browser, with https (or http://localhost). Its
# host name is accepted as an allowed host too. Without it passkeys are off.
#PAPERLESS_GO_PUBLIC_URL=https://docs.example.ts.net

# Where document files are stored on the host.
DATA_DIR=./data

# The consume folder on the host: files put into CONSUME_DIR/<user>/ are
# imported for that user and then deleted; files that cannot be imported
# move to CONSUME_DIR/<user>/failed/. The server creates the user folders.
# An empty PAPERLESS_GO_CONSUME_DIR= turns the consume folder off (Compose
# still mounts CONSUME_DIR, so Docker creates the folder if it is missing).
CONSUME_DIR=./consume
#PAPERLESS_GO_CONSUME_DIR=/consume

# debug, info, warn or error
PAPERLESS_GO_LOG_LEVEL=info

# Web UI. By default only this computer can reach it. To use it from your
# network or a VPN, set the address to listen on (0.0.0.0 for all, or a LAN
# or Tailscale IP) and every host name you type in the browser, then put
# HTTPS in front (reverse proxy or `tailscale serve`); see "Network access" in
# docs/reference/security.md.
#WEB_BIND=127.0.0.1
#WEB_PORT=8080
#PAPERLESS_GO_ALLOWED_HOSTS=localhost,127.0.0.1

# Reverse proxies (CIDR networks or addresses) whose X-Forwarded-For names
# the client, so the login limits and the audit log see the client, and
# whose X-Forwarded-Proto: https makes the session cookie Secure. Empty
# trusts none (X-Forwarded-Proto still counts from loopback).
# Always set it behind a proxy, also for one on the internet.
#PAPERLESS_GO_TRUSTED_PROXIES=172.16.0.0/12

# Largest file imported (upload, consume folder, CLI): bytes, or with KiB,
# MiB or GiB. Images may also have at most 50 megapixels.
#PAPERLESS_GO_MAX_UPLOAD_SIZE=100MiB

# Document processing in the web server: documents at once (0 turns it off),
# Tesseract languages, and the limit of each attempt.
#PAPERLESS_GO_OCR_WORKERS=1
#PAPERLESS_GO_OCR_LANGUAGES=deu+eng
#PAPERLESS_GO_OCR_TIMEOUT=30m

# The image of the web server and the CLI. A release bundle uses its own
# version (ghcr.io/pklnx/paperless-go:YY.MM-N); a clone builds it locally.
#PAPERLESS_GO_IMAGE=ghcr.io/pklnx/paperless-go:26.10-1
