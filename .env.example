# Copy to .env and fill in. Never commit .env.

# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me

# Required. Encrypts the two-factor (TOTP) secrets and keys the recovery
# codes. Generate it once with `./pgo keygen` and paste the line it prints
# here. Keep it with your backups: with another key nobody with two-factor
# login can log in (reset them with `./pgo user reset-2fa NAME`).
PAPERLESS_GO_SECRET_KEY=

# Admins always log in with a password and a TOTP code. true requires it
# for every user.
#PAPERLESS_GO_REQUIRE_2FA=false

# Where document files are stored on the host.
DATA_DIR=./data

# debug, info, warn or error
PAPERLESS_GO_LOG_LEVEL=info

# Web UI. By default only this computer can reach it. To use it from your
# network or a VPN, set the address to listen on (0.0.0.0 for all, or a LAN
# or Tailscale IP) and every host name you type in the browser, then put
# HTTPS in front (reverse proxy or `tailscale serve`). Keep the default until
# API keys and the security review are done (see docs/reference/security.md).
#WEB_BIND=127.0.0.1
#WEB_PORT=8080
#PAPERLESS_GO_ALLOWED_HOSTS=localhost,127.0.0.1

# Reverse proxies (CIDR networks or addresses) whose X-Forwarded-For names
# the client, so the login limits count per client. Empty trusts none.
#PAPERLESS_GO_TRUSTED_PROXIES=172.16.0.0/12

# Document processing in the web server: documents at once (0 turns it off),
# Tesseract languages, and the limit of each attempt.
#PAPERLESS_GO_OCR_WORKERS=1
#PAPERLESS_GO_OCR_LANGUAGES=deu+eng
#PAPERLESS_GO_OCR_TIMEOUT=30m

# The image of the web server and the CLI. A release bundle uses its own
# version (ghcr.io/pklnx/paperless-go:YY.MM-N); a clone builds it locally.
#PAPERLESS_GO_IMAGE=ghcr.io/pklnx/paperless-go:26.10-1
