# Copy to .env and fill in. Never commit .env.

# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me

# Where document files are stored on the host.
DATA_DIR=./data

# debug, info, warn or error
PAPERLESS_GO_LOG_LEVEL=info

# Web UI. By default only this computer can reach it. To use it from your
# network or a VPN, set the address to listen on (0.0.0.0 for all, or a LAN
# or Tailscale IP) and every host name you type in the browser, then put
# HTTPS in front (reverse proxy or `tailscale serve`). Login has no second
# factor yet: keep the default until two-factor login exists.
#WEB_BIND=127.0.0.1
#WEB_PORT=8080
#PAPERLESS_GO_ALLOWED_HOSTS=localhost,127.0.0.1

# Reverse proxies (CIDR networks or addresses) whose X-Forwarded-For names
# the client, so the login limits count per client. Empty trusts none.
#PAPERLESS_GO_TRUSTED_PROXIES=172.16.0.0/12

# Largest file imported (upload, consume folder, CLI): bytes, or with KiB,
# MiB or GiB. Images may also have at most 40 megapixels.
#PAPERLESS_GO_MAX_UPLOAD_SIZE=100MiB

# The image of the web server and the CLI. A release bundle uses its own
# version (ghcr.io/pklnx/paperless-go:YY.MM-N); a clone builds it locally.
#PAPERLESS_GO_IMAGE=ghcr.io/pklnx/paperless-go:26.10-1
